{
  "name": "flujo-finanzas",
  "version": "1.28.1",
  "main": "index.js",
  "engines": { "node": "^22.13.0 || ^24.3.0 || >=26.0.0" },
  "scripts": {
    "start": "node scripts/native-cli.cjs start",
    "android": "cd android && gradlew.bat assembleRelease",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check-source.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check && npm run typecheck && npm test",
    "audit:deps": "npm audit",
    "audit:native": "node scripts/audit-native.cjs",
    "perf:device": "node scripts/performance.cjs",
    "perf:domain": "node scripts/benchmark-domain.cjs",
    "format": "node scripts/format-source.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "lucide-react-native": "^1.27.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "^15.15.5"
  },
  "overrides": {
    "metro": "$metro",
    "metro-config": "$metro-config",
    "metro-core": "0.87.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.79.6",
    "@react-native/metro-babel-transformer": "0.79.6",
    "metro": "0.87.1",
    "metro-config": "0.87.1",
    "typescript": "^5.8.3"
  },
  "private": true
}
